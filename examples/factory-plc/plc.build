# QNX SDP 8.0 IFS — factory cell controller
[virtual=x86_64,bios +compress] boot = {
    startup-x86
    PATH=/proc/boot:/bin LD_LIBRARY_PATH=/proc/boot:/lib procnto-smp-instr
}

[+script] startup-script = {
    display_msg "cell controller"
    procmgr_symlink ../../proc/boot/libc.so.5 /usr/lib/ldqnx-64.so.2
    slogger2 &
    io-sock &
    plc_cell &
    supervisor &
    qconn &
}

libc.so.5
libsecpol.so
slogger2
io-sock
qconn
secpolpush
[type=link] /usr/lib/ldqnx-64.so.2=/proc/boot/libc.so.5
[uid=0 gid=0 perms=0755] /proc/boot/plc_cell = plc_cell
[uid=0 gid=0 perms=0755] /proc/boot/plc_cell = plc_cell
[uid=0 gid=0 perms=0755] /proc/boot/supervisor = supervisor
